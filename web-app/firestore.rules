rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Naya logic jisse Guest/Google Player ki Rank, Wins/Losses aur Profile Info safe aur secure rahegi.
    // Sirf wahi user apna data change kar sakta hai jo currently game khel raha ho (Guest ya Google account).
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Game Matchmaking ke rules - Authenticated users only
    match /games/{gameId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ------------------------------------------------------------------------
    // New Friend System & Match Invites Rules
    // ------------------------------------------------------------------------
    match /friendRequests/{requestId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid == resource.data.toUserId || request.auth.uid == resource.data.fromUserId);
      allow write: if request.auth != null;
    }
    
    // Global Chat Rules - Rate limiting handled by logic but auth required
    match /globalChat/{messageId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.text.size() <= 200;
      allow update, delete: if false; 
    }

    match /friends/{friendPairId} {
      allow read: if request.auth != null && (request.auth.uid in friendPairId.split('_'));
      allow write: if request.auth != null && (request.auth.uid in friendPairId.split('_'));
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null && (request.auth.uid in friendPairId.split('_'));
      }
    }
    
    match /gameInvites/{inviteId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Baaki sab safe rakhne ke liye naturally reject ho jayega
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
